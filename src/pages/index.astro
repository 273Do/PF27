---
import Layout from "@/components/layouts/layout.astro";
import { LogoAnimation } from "@/components/main/logo-animation";
import Profile from "@/components/main/profile.astro";
import Sandbox from "@/components/main/sandbox.astro";
import Skills from "@/components/main/skills.astro";
import Works from "@/components/main/works.astro";
import Separator from "@/components/ui/separator.astro";

import { getProfile, getWorksList, getSandboxList } from "@/lib/fetch-contents";

export const prerender = false;

const { profile, skills } = await getProfile();
const { contents: works } = await getWorksList();
const { contents: sandbox } = await getSandboxList();
---

<Layout>
  <LogoAnimation client:idle />
  <Profile profile={profile} />
  <Separator />
  <Skills skillList={skills} />
  <Works workList={works} />
  <Sandbox sandboxList={sandbox} />
</Layout>
