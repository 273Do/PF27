---
import Layout from "@/components/layouts/layout.astro";
import Separator from "@/components/ui/separator.astro";
import Detail from "@/components/works/detail.astro";
import Header from "@/components/works/header.astro";
import { SITE_TITLE } from "@/constants/metadata";
import { getWorksList, getWorksDetail } from "@/lib/fetch-contents";

export const getStaticPaths = async () => {
  const { contents: works } = await getWorksList();

  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      prevId: works[i + 1]?.id,
      nextId: works[i - 1]?.id,
    },
  }));
};

const { slug } = Astro.params;

const { prevId, nextId } = Astro.props;

export type aroundWorksObj = {
  aroundWorksIds: {
    prevId?: string;
    nextId?: string;
  };
};

const aroundWorksIds = { prevId, nextId };

const work = await getWorksDetail(slug);
const title = `${work.detail.title} | ${SITE_TITLE}`;
---

<Layout title={title}>
  <Header detail={work.detail} aroundWorksIds={aroundWorksIds} />
  <Separator />
  <Detail article={work.article} />
</Layout>
