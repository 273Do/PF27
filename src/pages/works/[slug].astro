---
import Layout from "@/components/layouts/layout.astro";
import Separator from "@/components/ui/separator.astro";
import Detail from "@/components/works/detail.astro";
import Header from "@/components/works/header.astro";
import { getWorksList, getWorksDetail } from "@/lib/fetch-contents";

export const getStaticPaths = async () => {
  const { contents: works } = await getWorksList();

  return works.map((work) => ({
    params: { slug: work.id },
  }));
};

const { slug } = Astro.params;

const work = await getWorksDetail(slug);
---

<Layout>
  <Header detail={work.detail} />
  <Separator />
  <Detail article={work.article} />
</Layout>
