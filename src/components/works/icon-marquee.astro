---
import type { TechObj } from "@/gen/types/microcms-schemas";

type Props = {
  techs: TechObj[];
};

const { techs } = Astro.props;

const loopCount = 27 / techs.length;
---

<div
  class="mt-2 -mb-2 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_20%,black_80%,transparent)]"
>
  <div
    class="flex w-max animate-[marquee_15s_linear_infinite] items-center gap-9 text-3xl text-primary"
  >
    {
      Array.from({ length: loopCount }).map(() =>
        techs.map((tech) => <i class={`si si-${tech.techName}`} />),
      )
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
