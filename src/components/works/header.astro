---
import Label from "@/components/ui/label.astro";
import IconMarquee from "./icon-marquee.astro";
import type { WorksObj } from "@/gen/types/microcms-schemas";
import type { aroundWorksObj } from "@/pages/works/[slug].astro";

type Props = {
  detail: Omit<WorksObj, "article">;
} & aroundWorksObj;

const { detail, aroundWorksIds } = Astro.props;

const { title, releaseDate, techs, tags, githubLink, appLink, otherLink } =
  detail;

const { prevId, nextId } = aroundWorksIds;
---

<header>
  <div class="flex flex-col gap-3">
    <div class="flex items-center justify-between">
      <a href="/" class="w-fit"> &#x2190; Back</a>
      <div class="flex gap-4">
        {
          prevId && (
            <a href={`/works/${prevId}`} class="w-fit">
              &#x2190; Prev
            </a>
          )
        }
        {
          nextId && (
            <a href={`/works/${nextId}`} class="w-fit">
              Next &#x2192;
            </a>
          )
        }
      </div>
    </div>
    <div class="flex flex-col justify-between">
      <div class="sm:flex items-center justify-between">
        <Label>{title}</Label>
        <p class="text-muted-foreground">
          {releaseDate.replace(/-/g, "").slice(2, 8)}
        </p>
      </div>
      <div class="flex items-center justify-between text-muted-foreground">
        <p>{tags.map((tag) => tag.tagName).join(", ")}</p>
        <div class="flex">
          {
            appLink && (
              <a
                href={appLink}
                target="_blank"
                rel="noopener noreferrer"
                class="cursor-alias hover:underline"
              >
                App
              </a>
            )
          }
          {
            githubLink && (
              <div class="flex items-center gap-1">
                {appLink && <span>,</span>}
                <a
                  href={githubLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cursor-alias hover:underline"
                >
                  GitHub
                </a>
              </div>
            )
          }
          {
            otherLink && (
              <div class="flex items-center gap-1">
                {(appLink || githubLink) && <span>,</span>}
                <a
                  href={otherLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cursor-alias hover:underline"
                >
                  Note
                </a>
              </div>
            )
          }
        </div>
      </div>
      <IconMarquee techs={techs} />
    </div>
  </div>
</header>
