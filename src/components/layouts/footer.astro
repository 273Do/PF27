---
import { getBannerList, getFooterProfile } from "@/lib/fetch-contents";
import { Image } from "astro:assets";

const { contents: banners } = await getBannerList();
const { mail, links } = await getFooterProfile();
---

<footer
  class="-mt-2 flex flex-col-reverse text-muted-foreground sm:flex-row sm:justify-between"
>
  <div class="mt-2 flex flex-col gap-2">
    <div class="flex flex-col gap-2">
      <button id="banner-copy" class="cursor-copy">
        <Image src="/imgs/banner.png" width="200" height="40" alt="banner" />
      </button>
      {
        banners?.map((banner) => (
          <a
            href={banner.link}
            class="cursor-alias"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={banner.imageLink}
              width="200"
              height="40"
              alt={banner.link}
            />
          </a>
        ))
      }
    </div>
  </div>
  <div class="z-10 flex flex-col bg-background sm:items-end">
    <a class="cursor-alias hover:underline" href={`mailto:${mail}`}>
      {mail}
    </a>
    <div class="flex gap-1 text-muted-foreground">
      {
        links.map(({ title, link }, i) => (
          <div class="flex items-center">
            <a
              href={link}
              class="cursor-alias hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {title}
            </a>
            <span>{i < links.length - 1 && ","}</span>
          </div>
        ))
      }
    </div>
  </div>
</footer>

<script>
  const URL = import.meta.env.SITE;

  function init() {
    const bannerHTML = `<a href="${URL}" target="_blank" rel="noopener noreferrer" class="cursor-copy"><img src="${URL}/imgs/banner.png" /></a>`;

    const bannerEl = document.getElementById("banner-copy");

    bannerEl?.addEventListener("click", () => {
      navigator.clipboard.writeText(bannerHTML);
      bannerEl.classList.add("copied");
      setTimeout(() => bannerEl.classList.remove("copied"), 1500);
    });
  }

  document.addEventListener("astro:page-load", init);
</script>

<style>
  .copied {
    cursor: context-menu;
  }
</style>
