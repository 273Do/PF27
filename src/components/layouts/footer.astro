---
import { SNS_LINKS, MAIL_ADDRESS } from "@/constants/links";
---

<footer class="-mt-2 justify-between text-muted-foreground sm:flex">
  <div class="flex flex-col gap-2 mt-2">
    <div class="flex items-end gap-2">
      <button id="banner-copy" class="cursor-copy">
        <img src="imgs/banner.png" />
      </button>
    </div>
  </div>
  <div class="z-10 flex flex-col items-end">
    <a class="cursor-alias hover:underline" href={`mailto:${MAIL_ADDRESS}`}>
      {MAIL_ADDRESS}
    </a>
    <div class="flex gap-1 bg-background text-muted-foreground">
      {
        SNS_LINKS.map(({ title, url }, i) => (
          <div class="flex items-center">
            <a
              href={url}
              class="cursor-alias hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {title}
            </a>
            <span>{i < SNS_LINKS.length - 1 && ","}</span>
          </div>
        ))
      }
    </div>
  </div>
</footer>

<script>
  const URL = import.meta.env.SITE;

  function init() {
    const bannerEl = `<a href="${URL}" target="_blank" rel="noopener noreferrer" class="cursor-copy"><img src="imgs/banner.png" /></a>`;

    document.getElementById("banner-copy")?.addEventListener("click", () => {
      navigator.clipboard.writeText(bannerEl);
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
