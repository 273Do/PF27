---
const MAIL_ADDRESS: string = "hogehoge@gmail.com";

const SNS_LINKS: string[] = ["GitHub", "Discord", "X(Twitter)", "Note"];
---

<div class="-mt-2 flex justify-between text-muted-foreground">
  <a class="cursor-alias hover:underline" href={`mailto:${MAIL_ADDRESS}`}>
    {MAIL_ADDRESS}
  </a>
  <div class="flex gap-2 text-muted-foreground">
    {
      SNS_LINKS.map((name, i) => (
        <div class="flex cursor-alias">
          <p class="hover:underline">{name}</p>
          <span>{i < SNS_LINKS.length - 1 && ","}</span>
        </div>
      ))
    }
  </div>
</div>
