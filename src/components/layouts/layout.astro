---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import { AreaDegradationCanvas } from "@/components/main/area-degradation-canvas.tsx";
import "@/styles/global.css";
import Separator from "@/components/ui/separator.astro";
import { SITE_TITLE } from "@/constants/metadata";

import Footer from "./footer.astro";
import GlobalMetadata from "./global-metadata.astro";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const { title: customTitle, description, noindex } = Astro.props;

const pathname = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, "")
  .split("/")[0];

const section = pathname
  ? `${SITE_TITLE} | ${pathname[0].toUpperCase() + pathname.slice(1)}`
  : SITE_TITLE;
const title = customTitle || section;
---

<html lang="ja">
  <head>
    <GlobalMetadata title={title} description={description} noindex={noindex} />
    <Font cssVariable="--font-zen-old-mincho" preload />
    <ClientRouter />
  </head>
  <body
    class="my-25 flex w-full justify-center bg-background font-serif antialiased selection:bg-secondary-foreground selection:text-primary-foreground"
  >
    <AreaDegradationCanvas client:idle />
    <div class="w-full max-w-2xl px-4 sm:mx-4 sm:w-auto sm:px-0">
      <slot />
      <Separator />
      <Footer />
    </div>
  </body>
</html>
