---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import "@/styles/global.css";
import Separator from "@/components/ui/separator.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/constants/metadata";

import Footer from "./footer.astro";
import GlobalMetadata from "./global-metadata.astro";

const pathname = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, "")
  .split("/")[0];

const section =
  pathname && `| ${pathname[0].toUpperCase() + pathname.slice(1)}`;
const title = `${SITE_TITLE} ${section}`;
---

<html lang="ja">
  <head>
    <GlobalMetadata title={title} />
    <Font cssVariable="--font-zen-old-mincho" preload />
    <ClientRouter />
  </head>
  <body
    class="my-25 flex w-full justify-center bg-background font-serif antialiased selection:bg-secondary-foreground selection:text-primary-foreground"
  >
    <div class="w-full max-w-2xl px-4 sm:mx-4 sm:w-auto sm:px-0">
      <slot />
      <Separator />
      <Footer />
    </div>
  </body>
</html>
