---
import Label from "../label.astro";

const skills: string[] = [
  "Language",
  "Frontend",
  "Backend",
  "DevOps",
  "Creative",
  "Piano",
];
---

<div class="mt-6 flex flex-col">
  <Label>Skills</Label>
  <div class="flex gap-2 text-muted-foreground">
    {
      skills.map((skill, i) => (
        <div class="flex">
          <p>{skill}</p>
          <span>{i < skills.length - 1 && ","}</span>
        </div>
      ))
    }
  </div>
</div>
