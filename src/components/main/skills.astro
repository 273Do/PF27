---
import Label from "../label.astro";

const skills: string[] = [
  "Language",
  "Frontend",
  "Backend",
  "DevOps",
  "Creative",
  "Piano",
];
---

<div class="mt-6 flex flex-col">
  <Label>Skills</Label>
  <p class="text-muted-foreground">
    {
      skills.map((skill, i) => (
        <>
          {i > 0 && ", "}
          <span class="underline">{skill}</span>
        </>
      ))
    }
  </p>
</div>
