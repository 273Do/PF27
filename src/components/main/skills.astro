---
import Label from "@/components/ui/label.astro";
import type { SkillObj } from "@/gen/types/microcms-schemas";

type Props = {
  skillList: SkillObj[];
};

const { skillList } = Astro.props;
---

<div class="mt-6 flex flex-col">
  <div class="items-center justify-between sm:flex">
    <Label>Skills</Label>
    <div class="relative h-6 w-full">
      {
        skillList.map(({ skills }) => (
          <p
            data-detail
            class="whitespace-wrap absolute left-0 text-muted-foreground opacity-0 transition-opacity duration-300 sm:right-0 sm:left-auto"
          >
            {skills}
          </p>
        ))
      }
    </div>
  </div>
  <div class="mt-6 flex w-full flex-wrap gap-0.5 text-muted-foreground sm:mt-2">
    {
      skillList.map(({ skillGenre }, i) => (
        <div class="flex items-center">
          <p
            data-skill={i}
            class="cursor-pointer px-0.5 leading-tight transition-all duration-300"
          >
            {skillGenre}
          </p>
          <p>{i < skillList.length - 1 && ","}</p>
        </div>
      ))
    }
  </div>
</div>

<script>
  function init() {
    const skillEls = document.querySelectorAll<HTMLElement>("[data-skill]");
    const detailEls = document.querySelectorAll<HTMLElement>("[data-detail]");

    skillEls.forEach((el, i) => {
      el.addEventListener("mouseenter", () => {
        skillEls.forEach((s) => {
          s.classList.remove("bg-primary", "text-secondary");
        });
        detailEls.forEach((d) => d.classList.add("opacity-0"));

        el.classList.remove("opacity-30");
        el.classList.add("bg-primary", "text-secondary");
        detailEls[i]?.classList.remove("opacity-0");
      });
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
