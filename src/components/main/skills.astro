---
import Label from "@/components/ui/label.astro";

const skills = [
  { name: "Language", detail: "TypeScript, Python, PHP, GO, GLSL" },
  {
    name: "Frontend",
    detail:
      "React, Next.js, Vue.js, Astro, React Native, Tailwind CSS, R3F, GSAP, p5.js",
  },
  {
    name: "Backend",
    detail: "FastAPI, Flask, Laravel, MySQL, PostgreSQL, BaaS",
  },
  {
    name: "DevOps",
    detail: "Docker, Github Actions, AWS, Devcontainer, Claude Code, Ollama",
  },
  { name: "Creative", detail: "Figma, Blender, Affinity, Cavalry" },
  { name: "Piano", detail: "KORG SV-1" },
];
---

<div class="mt-6 flex flex-col">
  <div class="flex items-center justify-between">
    <Label>Skills</Label>
    <div class="relative h-6">
      {
        skills.map((skill) => (
          <p
            data-detail
            class="absolute right-0 whitespace-nowrap text-muted-foreground opacity-0 transition-opacity duration-300"
          >
            {skill.detail}
          </p>
        ))
      }
    </div>
  </div>
  <div class="mt-2 flex gap-0.5 text-muted-foreground">
    {
      skills.map((skill, i) => (
        <div class="flex items-center">
          <p
            data-skill={i}
            class="cursor-pointer px-0.5 leading-tight transition-all duration-300"
          >
            {skill.name}
          </p>
          <p>{i < skills.length - 1 && ","}</p>
        </div>
      ))
    }
  </div>
</div>

<script>
  function init() {
    const skillEls = document.querySelectorAll<HTMLElement>("[data-skill]");
    const detailEls = document.querySelectorAll<HTMLElement>("[data-detail]");

    skillEls.forEach((el, i) => {
      el.addEventListener("mouseenter", () => {
        skillEls.forEach((s) => {
          s.classList.remove("bg-primary", "text-secondary");
        });
        detailEls.forEach((d) => d.classList.add("opacity-0"));

        el.classList.remove("opacity-30");
        el.classList.add("bg-primary", "text-secondary");
        detailEls[i]?.classList.remove("opacity-0");
      });
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
