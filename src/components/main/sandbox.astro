---
import Label from "@/components/ui/label.astro";
import type { Sandbox } from "@/types/contents";

type Props = {
  sandboxList: Sandbox[];
};

const { sandboxList } = Astro.props;
---

<div class="mt-6 flex flex-col gap-2">
  <div class="items-center justify-between sm:flex">
    <Label>Sandbox</Label>
    <p>Play Ground, R&D Collection, Experiments</p>
  </div>
  <div data-sandbox class="flex w-full items-start gap-4">
    <div class="w-full sm:w-1/2">
      <div class="w-full">
        {sandboxList.map(({ title, image, tags, link }, i) => (
          <div>
            <a
              data-row={i}
              href={link}
              class="flex cursor-pointer items-center justify-between py-1 transition-opacity duration-300 sm:cursor-alias"
              target="_blank"
              rel="noopener noreferrer"
            >
              <p class="text-primary">{title}</p>
              <p>{tags.map((tag) => tag.tagName).join(", ")}</p>
            </a>
            <a
              data-img-mobile={i}
              href={link}
              class="hidden cursor-alias"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={image.url} alt={title} class="w-full sm:hidden" />
            </a>
          </div>
        ))}
      </div>
    </div>
    <div class="relative hidden w-1/2 invert sm:block">
      {sandboxList.map(({ title, image, tags, link }, i) => (
        <div data-img={i} class="absolute inset-0 opacity-0 transition-opacity duration-300">
          <img src={image.url} alt={title} class="w-full invert" />
          <div class="absolute inset-0 transition-opacity duration-300 [[data-sandbox]:hover_&]:opacity-0">
            <div class="dither-2xl w-full">
              <img src={image.url} alt={title} class="w-full invert" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function init() {
    const rows = document.querySelectorAll<HTMLElement>("[data-row]");
    const imgs = document.querySelectorAll<HTMLElement>("[data-img]");
    const imgsMobile = document.querySelectorAll<HTMLElement>("[data-img-mobile]");

    const isMobile = () => window.matchMedia("(max-width: 639px)").matches;

    const showRow = (row: HTMLElement, i: number) => {
      rows.forEach((r) => r.classList.add("opacity-30"));
      row.classList.remove("opacity-30");

      imgs.forEach((img) => img.classList.add("opacity-0"));
      imgs[i]?.classList.remove("opacity-0");

      imgsMobile.forEach((img) => img.classList.add("hidden"));
      imgsMobile[i]?.classList.remove("hidden");
    };

    rows.forEach((row, i) => {
      row.addEventListener("mouseenter", () => {
        if (!isMobile()) showRow(row, i);
      });

      row.addEventListener("click", (e) => {
        if (isMobile()) {
          e.preventDefault();
          showRow(row, i);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
