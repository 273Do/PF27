---
import Label from "@/components/ui/label.astro";

type WorkObj = {
  name: string;
  tags: string[];
  imageUrl: string;
};

const works: WorkObj[] = [
  {
    imageUrl: "https://picsum.photos/seed/canvas/600/380",
    name: "Canvas Flow",
    tags: ["Tool", "Creative"],
  },
  {
    imageUrl: "https://picsum.photos/seed/type/380/520",
    name: "Type Grid",
    tags: ["App", "Design"],
  },
  {
    imageUrl: "https://picsum.photos/seed/midi/600/280",
    name: "Midi Map",
    tags: ["Tool", "Music"],
  },
  {
    imageUrl: "https://picsum.photos/seed/sensor/440/600",
    name: "Sensor Viz",
    tags: ["App", "Sensor"],
  },
  {
    imageUrl: "https://picsum.photos/seed/wave/600/340",
    name: "Wave Form",
    tags: ["Tool", "Audio"],
  },
  {
    imageUrl: "https://picsum.photos/seed/palette/360/480",
    name: "Palette Gen",
    tags: ["App", "Design"],
  },
  {
    imageUrl: "https://picsum.photos/seed/log/600/420",
    name: "Log Viewer",
    tags: ["Tool", "DevOps"],
  },
  {
    imageUrl: "https://picsum.photos/seed/font/420/600",
    name: "Font Lab",
    tags: ["App", "Design"],
  },
  {
    imageUrl: "https://picsum.photos/seed/mesh/600/300",
    name: "Mesh Grid",
    tags: ["Tool", "Creative"],
  },
  {
    imageUrl: "https://picsum.photos/seed/noise/480/600",
    name: "Noise Gen",
    tags: ["App", "Creative"],
  },
  {
    imageUrl: "https://picsum.photos/seed/dark/600/460",
    name: "Dark Room",
    tags: ["Tool", "Photo"],
  },
  {
    imageUrl: "https://picsum.photos/seed/seq/320/300",
    name: "Seq Step",
    tags: ["App", "Music"],
  },
];
---

<div class="mt-6 flex flex-col gap-2">
  <div class="items-center justify-between sm:flex">
    <Label>Sandbox</Label>
    <p class="text-muted-foreground">
      Play Ground, R&D Collection, Experiments
    </p>
  </div>
  <div data-sandbox class="flex w-full items-start gap-4">
    <div class="w-full sm:w-1/2">
      <div class="w-full text-muted-foreground">
        {
          works.map((work, i) => (
            <div>
              <div
                data-row={i}
                class="flex cursor-alias items-center justify-between py-1 transition-opacity duration-300"
              >
                <p class="text-primary">{work.name}</p>
                <p>{work.tags.join(", ")}</p>
              </div>
              <div data-img-mobile={i} class="hidden">
                <img
                  src={work.imageUrl}
                  alt={work.name}
                  class="w-full sm:hidden"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="relative hidden w-1/2 invert sm:block">
      {
        works.map((work, i) => (
          <div
            data-img={i}
            class="absolute inset-0 opacity-0 transition-opacity duration-300"
          >
            <img src={work.imageUrl} alt={work.name} class="w-full invert" />
            <div class="absolute inset-0 transition-opacity duration-300 [[data-sandbox]:hover_&]:opacity-0">
              <div class="dither-2xl w-full">
                <img
                  src={work.imageUrl}
                  alt={work.name}
                  class="w-full invert"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  function init() {
    const rows = document.querySelectorAll<HTMLElement>("[data-row]");
    const imgs = document.querySelectorAll<HTMLElement>("[data-img]");
    const imgsMobile =
      document.querySelectorAll<HTMLElement>("[data-img-mobile]");

    rows.forEach((row, i) => {
      row.addEventListener("mouseenter", () => {
        rows.forEach((r) => r.classList.add("opacity-30"));
        row.classList.remove("opacity-30");

        imgs.forEach((img) => img.classList.add("opacity-0"));
        imgs[i]?.classList.remove("opacity-0");

        imgsMobile.forEach((img) => img.classList.add("hidden"));
        imgsMobile[i]?.classList.remove("hidden");
      });
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
