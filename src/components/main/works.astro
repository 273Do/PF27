---
import Label from "@/components/ui/label.astro";
import type { WorksListItem } from "@/lib/fetch-contents";

type Props = {
  workList: WorksListItem[];
};

const { workList } = Astro.props;

const seenYears = new Set<string>();

const formatDate = (dateStr: string) => {
  const d = dateStr.replace(/-/g, "").slice(0, 8);
  const yy = d.slice(2, 4);
  const mmdd = d.slice(4, 8);
  if (seenYears.has(yy)) return mmdd;
  seenYears.add(yy);
  return yy + mmdd;
};
---

<div class="mt-6 flex flex-col gap-2">
  <Label>Works</Label>
  <div class="group text-muted-foreground">
    {
      workList.map((work) => (
        <div class="flex cursor-pointer items-center gap-2 py-1 transition-opacity group-hover:opacity-30 hover:opacity-100">
          <a
            href={`works/${work.id}`}
            class="flex w-full items-center justify-between"
          >
            <p class="text-primary">{work.title}</p>
            <p>{work.tags.map((tag) => tag.tagName).join(", ")}</p>
          </a>
          <p class="w-14 shrink-0">{formatDate(work.releaseDate)}</p>
        </div>
      ))
    }
  </div>
</div>
