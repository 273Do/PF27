---
import { Image } from "astro:assets";

import Label from "@/components/ui/label.astro";
import type { ProfileObj } from "@/gen/types/microcms-schemas";

type Props = { profile: Omit<ProfileObj, "skills"> };

const { profile } = Astro.props;

const { name, bio, description, icon } = profile;
---

<div class="mt-6 flex flex-col gap-4">
  <div class="flex items-center gap-4">
    <Image
      src={icon.url}
      width={75}
      height={75}
      alt={name}
      class="z-10 rounded-full"
    />
    <div>
      <Label>{name}</Label>
      <p class="text-muted-foreground">
        {bio}
      </p>
    </div>
  </div>
  <p class="text-muted-foreground">
    {description}
  </p>
</div>
